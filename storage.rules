rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.uid == "super_admin_01" ||
        request.auth.token.email == "admin@iombg.com" ||
        request.auth.token.email == "bhushangawali208@gmail.com" ||
        request.auth.token.role == "SUPER_ADMIN" ||
        request.auth.token.isSuperAdmin == true ||
        request.auth.token.super_admin == true
      );
    }

    function isValidImage() {
      return request.resource.contentType.matches('image/.*') &&
             request.resource.size < 15 * 1024 * 1024; // 15MB max
    }

    function isValidVideo() {
      return request.resource.contentType.matches('video/.*') &&
             request.resource.size < 500 * 1024 * 1024; // 500MB max
    }

    // ==================== USER PROFILE ASSETS ====================
    match /users/{userId}/{allPaths=**} {
      allow read: if true; // Public user avatars
      allow write: if isOwner(userId) && isValidImage() || isSuperAdmin();
      allow delete: if isOwner(userId) || isSuperAdmin();
    }

    // ==================== CREATOR CHANNEL ASSETS ====================
    match /channels/{channelId}/avatars/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated() && isValidImage() || isSuperAdmin();
      allow delete: if isAuthenticated() || isSuperAdmin();
    }

    match /channels/{channelId}/banners/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated() && isValidImage() || isSuperAdmin();
      allow delete: if isAuthenticated() || isSuperAdmin();
    }

    // ==================== VIDEO CONTENT & THUMBNAILS ====================
    match /channels/{channelId}/thumbnails/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated() && isValidImage() || isSuperAdmin();
      allow delete: if isAuthenticated() || isSuperAdmin();
    }

    match /channels/{channelId}/videos/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated() && isValidVideo() || isSuperAdmin();
      allow delete: if isAuthenticated() || isSuperAdmin();
    }

    // ==================== SHORTS CONTENT ====================
    match /channels/{channelId}/shorts/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated() && isValidVideo() || isSuperAdmin();
      allow delete: if isAuthenticated() || isSuperAdmin();
    }

    // ==================== CHAT ATTACHMENTS ====================
    match /conversations/{conversationId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (isValidImage() || request.resource.size < 25 * 1024 * 1024);
      allow delete: if isAuthenticated() || isSuperAdmin();
    }

    // Default deny
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
  }
}
